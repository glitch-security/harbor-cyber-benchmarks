#!/bin/sh
# Docker HEALTHCHECK for the sidecar. Proves AUTHENTIC service readiness, not just
# that the warden is listening: the warden's /control/health only reports
# "target_ready":true after it has probed TARGET_HEALTH_URL on the real service
# (checklist G-09/F-10).
set -eu
curl --noproxy '*' --max-time 2 -fsS http://127.0.0.1:${TARGET_CONTROL_PORT:-19999}/control/health | grep -q '"target_ready":true'
