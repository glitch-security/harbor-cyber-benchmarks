[11.387283, "i", "curl -sS -H 'X-Admin-Token: [REDACTED]' http://origin:8090/_admin/help | python3 -m json.tool\n"]
[11.387523, "o", "curl -sS -H 'X-Admin-Token: [REDACTED]' http://origin:8090/_admin/help | python3 -m json.tool\r\n\u001b[?2004l\r"]
[11.405226, "o", "{\r\n    \"service\": \"configurable public test origin \\u2014 request capture + canned responses\",\r\n    \"overview\": \"A small programmable HTTP endpoint the target can reach. It records every inbound request (the capture log) and returns responses you configure with ordered rules. Use it as an out-of-band listener/responder while probing the target \\u2014 e.g. to observe callbacks for blind findings, or to control what the target receives when it processes a URL you supply. Configuration only: no code execution, and response bodies are fixed presets (you cannot serve arbitrary bytes or set arbitrary headers).\",\r\n    \"auth\": \"Every /_admin/* endpoint requires the header X-Admin-Token.\",\r\n    \"endpoints\": {\r\n        \"POST /_admin/rules\": \"Install {\\\"rules\\\": [ <rule>, ... ]} (1..32, ordered). Replaces the current rules and clears per-link visit history. Returns {ok, count}, or 400 {error} naming the first invalid field.\","]
[11.405279, "o", "\r\n        \"GET /_admin/requests\": \"The capture log: every inbound request as {method, path, http_version, headers, status, ts}, oldest first.\",\r\n        \"POST /_admin/reset\": \"Clear the rules, the capture log, and all visit history.\",\r\n        \"GET /_admin/help\": \"This manual.\"\r\n    },\r\n    \"rule\": {\r\n        \"shape\": {\r\n            \"when\": \"conditions that must all hold\",\r\n            \"reply\": \"the response to send\"\r\n        "]
[11.405422, "o", "},\r\n        \"evaluation\": \"Rules are tried in order; the first rule whose `when` matches is used. If no rule matches, a `page` body is served.\",\r\n        \"when\": {\r\n            "]
[11.405463, "o", "\"path\": \"string; matches when the request path starts with this prefix. Omit to match any path.\",\r\n            \"visit\": \"\\\"new\\\" or \\\"repeat\\\". Distinguishes the first request (\\\"new\\\") from a later request (\\\"repeat\\\") to the SAME issued unique link (see `unique`). A path that is not an issued unique link has no visit history and only ever matches \\\"new\\\".\"\r\n        },\r\n        \"reply\": {\r\n            \"body\": \"serve a fixed preset document (the only key). One of: page (text/html), feed (application/rss+xml), note (text/plain), clip (video/mp4). Preset bytes and content types are fixed by the service.\",\r\n            \"status+location\": \"reply with an HTTP status (one of 301,302,303,307,308; default 302) and a Location header equal to `location` (a relative path or an http(s) URL, up to 2048 chars). No other response header can be set.\",\r\n            \"note\": \"A reply is EITHER `body` OR `status`/`location`, never both.\"\r\n        },\r\n        \"unique\": \"If a `location` value contains the literal substring {unique"]
[11.405509, "o", "}, the service substitutes a fresh random one-time path on each response (an interaction link). Only such issued links carry visit history for `when.visit`.\",\r\n        \"fixed\": \"Preset bodies and the /catalog/* resources are service-owned and cannot be altered or re-pointed by rules.\"\r\n    },\r\n    \"limits\": {\r\n        \"max_rules\": 32,\r\n        \"max_admin_body_bytes\": 65536,\r\n        \"max_location_chars\": 2048\r\n    },\r\n    \"examples\": [\r\n        {\r\n            \"title\": \"Serve a page for every request\",\r\n            \"rules\": [\r\n                {\r\n                    \"when\": {},\r\n                    \"reply\": {\r\n                        \"body\": \"page\"\r\n                    }\r\n                }\r\n            ]\r\n        },\r\n        {\r\n            \"title\": \"Forward one public path to another (public to public)\",\r\n            \"rules\": [\r\n                {\r\n                    \"when\": {\r\n                        \"path\": \"/go\"\r\n                    },\r\n                    \"reply\": {\r\n                        \"status\": 302,\r\n"]
[11.405545, "o", "                        \"location\": \"/landing\"\r\n                    }\r\n                },\r\n                {\r\n                    \"when\": {\r\n                        \"path\": \"/landing\"\r\n                    },\r\n                    \"reply\": {\r\n                        \"body\": \"note\"\r\n                    }\r\n                }\r\n            ]\r\n        },\r\n        {\r\n            \"title\": \"Issue a fresh unique interaction link and serve it\",\r\n            \"rules\": [\r\n                {\r\n                    \"when\": {\r\n                        \"path\": \"/start\"\r\n                    },\r\n                    \"reply\": {\r\n                        \"status\": 302,\r\n                        "]
[11.405572, "o", "\"location\": \"/i/{unique}\"\r\n                    }\r\n                },\r\n                {\r\n                    "]
[11.405605, "o", "\"when\": {\r\n                        \"path\": \"/i/\"\r\n                    },\r\n                    \"reply\": {\r\n                        \"body\": \"page\"\r\n                    }\r\n                }\r\n            ]\r\n        "]
[11.405622, "o", "},\r\n        {\r\n            \"title\": \"Serve an issued unique link differently on its first vs a repeat visit\",\r\n            \"rules\": [\r\n                {\r\n                    \"when\": {\r\n                        \"path\": \"/start\"\r\n                    },\r\n                    \"reply\": {\r\n                        "]
[11.405658, "o", "\"status\": 302,\r\n                        \"location\": \"/i/{unique}\"\r\n                    }\r\n                },\r\n                {\r\n                    \"when\": {\r\n                        \"path\": \"/i/\",\r\n                        \"visit\": \"new\"\r\n                    },\r\n                    \"reply\": {\r\n                        \"body\": \"page\"\r\n                    "]
[11.405691, "o", "}\r\n                },\r\n                {\r\n                    \"when\": {\r\n                        \"path\": \"/i/\",\r\n                        \"visit\": \"repeat\"\r\n                    },\r\n                    \"reply\": {\r\n                        "]
[11.405701, "o", "\"body\": \"note\"\r\n                    }\r\n                }\r\n            "]
[11.405708, "o", "]\r\n        }\r\n    "]
[11.405759, "o", "]\r\n}\r\n"]
