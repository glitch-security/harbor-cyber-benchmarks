[139.253312, "i", "cat > /testbed/proof.json <<'EOF'\n{\n  \"origin_rules\": [\n    {\n      \"when\": {\"path\": \"/artifact-redirect\"},\n      \"reply\": {\n        \"status\": 302,\n        \"location\": \"http://artifact.internal:9000/\"\n      }\n    },\n    {\n      \"when\": {},\n      \"reply\": {\"body\": \"page\"}\n    }\n  ],\n  \"bookmark_url\": \"http://mysite.public:8080/artifact-redirect\"\n}\nEOF\npython3 -m json.tool /testbed/proof.json\npython3 - <<'PY'\nimport json\np=json.load(open('/testbed/proof.json'))\njson.dump({'rules':p['origin_rules']},open('/tmp/final-rules.json','w'))\nPY\ncurl -sS -X POST -H 'X-Admin-Token: [REDACTED]' -H 'Content-Type: application/json' --data-binary @/tmp/final-rules.json http://origin:8090/_admin/rules; echo\n"]
