                    </div>
                    <div class="card-content">
                        <p>
    <label for="id_name">Entity Name:</label>
    <input type="text" name="name" class="input is-large" placeholder="Entity name..." required maxlength="150" id="id_name">
    
    
  </p>

  
  <p>
    <label for="id_address_1">Address Line 1:</label>
    <input type="text" name="address_1" class="input" placeholder="Address line 1" maxlength="70" id="id_address_1">
    
    
  </p>

  
  <p>
    <label for="id_address_2">Address Line 2:</label>
