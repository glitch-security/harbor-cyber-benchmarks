[27.627707, "o", "HTTP/1.1 200 OK\r\r\n\u001b[1mCache-Control\u001b[0m: max-age=0, no-cache, no-store, must-revalidate, private\r\r\n\u001b[1mContent-Length\u001b[0m: 5415\r\r\n\u001b[1mContent-Type\u001b[0m: text/html; charset=utf-8\r\r\n\u001b[1mCross-Origin-Opener-Policy\u001b[0m: same-origin\r\r\n\u001b[1mDate\u001b[0m: Thu, 22 Oct 2026 07:55:17 GMT\r\r\n\u001b[1mExpires\u001b[0m: Thu, 22 Oct 2026 07:55:17 GMT\r\r\n\u001b[1mReferrer-Policy\u001b[0m: same-origin\r\r\n\u001b[1mServer\u001b[0m: Ledger Service\r\r\n\u001b[1mSet-Cookie\u001b[0m: csrftoken=JN8j1U8IkPowoHl60CPCORVg1SnTUknP; expires=Thu, 21 Oct 2027 07:55:17 GMT; Max-Age=31449600; Path=/; SameSite=Lax\r\r\n\u001b[1mVary\u001b[0m: Cookie\r\r\n\u001b[1mX-Content-Type-Options\u001b[0m: nosniff\r\r\n"]
[27.627773, "o", "\u001b[1mX-Frame-Options\u001b[0m: DENY\r\r\n\r\r\n\r\n\r\n\r\n\r\n<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"utf-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n    <meta name=\"color-scheme\" content=\"light dark\">\r\n    <title>Login | </title>\r\n\r\n    <script>\r\n        (function () {\r\n            try {\r\n                var saved = localStorage.getItem('djl-theme');\r\n                var theme;\r\n                if (saved === 'dark' || saved === 'light') {\r\n                    theme = saved;\r\n                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {\r\n                    theme = 'dark';\r\n                } else {\r\n"]
[27.627818, "o", "                    theme = 'light';\r\n                }\r\n                document.documentElement.setAttribute('data-theme', theme);\r\n            } catch (e) {\r\n                document.documentElement.setAttribute('data-theme', 'light');\r\n            }\r\n        })();\r\n    </script>\r\n\r\n    <!-- Bulma base, then Bulmaswatch theme, then our overrides -->\r\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css\">\r\n    <link rel=\"stylesheet\"\r\n          href=\"https://cdn.jsdelivr.net/gh/jenil/bulmaswatch@gh-pages/litera/bulmaswatch.min.css\">\r\n    <link rel=\"stylesheet\" href=\"/static/django_ledger/css/djl_styles.css\">\r\n\r\n    <script src=\"https://code.iconify.design/iconify-icon/2.3.0/iconify-icon.min.js\"></script>\r\n\r\n    <link rel=\"shortcut icon\" type=\"image/jpg\" href=\"/static/django_ledger/logo/favicon.png\">\r\n\r\n    \r\n    \r\n\r\n</head>\r\n\r\n<body>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n\r\n\r\n    <section class=\"hero is-fullheight\"\r\n             id=\"djl-login-bg-image\"\r\n             style=\"background-ima"]
[27.627864, "o", "ge: url(/static/django_ledger/img/daniel-weiss-aj2Os9mYgJU-unsplash.jpg)\">\r\n        <div class=\"hero-body\">\r\n            <div class=\"container is-fluid\">\r\n                <div class=\"columns is-centered\">\r\n                    <div class=\"column is-6-tablet is-4-desktop\">\r\n                        <div class=\"box\">\r\n                            <div class=\"container\" style=\"padding: 20px;\">\r\n                                <div class=\"figure\">\r\n                                    <img src=\"/static/django_ledger/logo/django-ledger-logo.png\" alt=\"\">\r\n                                </div>\r\n                            </div>\r\n                            <form action=\"/auth/login/\" method=\"post\" id=\"djl-el-login-form\">\r\n                                <input type=\"hidden\" name=\"csrfmiddlewaretoken\" value=\"sWQUF3IQYznnJja51X3J7cwJ7UpjJcas1zO3wNGo8eBJXQl1RpIbLThPYCC2tmn7\">\r\n                                <div class=\"columns is-multiline\">\r\n                                    <div class=\"column is-12\"><div>\r\n    <labe"]
[27.6279, "o", "l for=\"djl-el-login-form-username-field\">Username:</label>\r\n\r\n\r\n\r\n<input type=\"text\" name=\"username\" autofocus class=\"input\" id=\"djl-el-login-form-username-field\" autocapitalize=\"none\" autocomplete=\"username\" maxlength=\"150\" required>\r\n    \r\n</div>\r\n\r\n  <div>\r\n    <label for=\"djl-el-login-form-password-field\">Password:</label>\r\n\r\n\r\n\r\n<input type=\"password\" name=\"password\" autocomplete=\"current-password\" class=\"input\" id=\"djl-el-login-form-password-field\" required>\r\n    \r\n      \r\n    \r\n</div></div>\r\n                                    <div class=\"column is-12\">\r\n                                        <button type=\"submit\"\r\n                                                class=\"button is-primary is-fullwidth\">\r\n                                            Login\r\n                                        </button>\r\n                                    </div>\r\n                                </div>\r\n                            </form>\r\n                        </div>\r\n                    </div>\r\n                </div"]
[27.627931, "o", ">\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n\r\n\r\n    <script src=\"/static/django_ledger/bundle/djetler.bundle.js\"></script>\r\n\r\n    <script>\r\n        \r\n\r\n        \r\n\r\n        \r\n    </script>\r\n\r\n    <script>\r\n        // Theme toggle logic\r\n        (function () {\r\n            function applyTheme(theme) {\r\n                document.documentElement.setAttribute('data-theme', theme);\r\n                try {\r\n                    localStorage.setItem('djl-theme', theme);\r\n                } catch (e) {\r\n                }\r\n                var icon = document.getElementById('djl-theme-toggle-icon');\r\n                var label = document.getElementById('djl-theme-toggle-label');\r\n                var btn = document.getElementById('djl-theme-toggle');\r\n                if (btn) btn.setAttribute('aria-pressed', theme === 'dark');\r\n                if (icon) icon.setAttribute('icon', theme === 'dark' ? 'mdi:weather-night' : 'mdi:weather-sunny');\r\n                if (label) label.textContent = theme === 'dark' ? 'Dar"]
[27.627964, "o", "k' : 'Light';\r\n            }\r\n\r\n            function initThemeToggle() {\r\n                var current = document.documentElement.getAttribute('data-theme') || 'light';\r\n                applyTheme(current);\r\n                var toggle = document.getElementById('djl-theme-toggle');\r\n                if (!toggle) return;\r\n                toggle.addEventListener('click', function () {\r\n                    var t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';\r\n                    applyTheme(t);\r\n                });\r\n            }\r\n\r\n            if (document.readyState === 'loading') {\r\n                document.addEventListener('DOMContentLoaded', initThemeToggle);\r\n            } else {\r\n                initThemeToggle();\r\n            }\r\n        })();\r\n    </script>\r\n\r\n\r\n\r\n\r\n</body>\r\n"]
