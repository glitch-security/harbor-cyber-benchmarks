[36.442379, "i", "for p in '/ledger/northstar-operations-dne37zdj/list/current/' '/journal-entry/northstar-operations-dne37zdj/318c2ebe-20c7-4155-ade2-afddb72e26f8/detail/80dd04ac-eedb-4b59-9a51-b3ec8ba733c6/' '/journal-entry/northstar-operations-dne37zdj/318c2ebe-20c7-4155-ade2-afddb72e26f8/update/80dd04ac-eedb-4b59-9a51-b3ec8ba733c6/mark-as-posted/'; do echo \"==== $p\"; curl -sS -b /tmp/ledger.cookies --max-time 8 \"http://127.0.0.1:9090$p\" -o /tmp/ledger-page.html; python3 - <<'PY'\nfrom bs4 import BeautifulSoup\ns=BeautifulSoup(open('/tmp/ledger-page.html').read(),'html.parser')\nfor a in s.select('a[href]'):\n if any(w in a.get('href','') for w in ('journal-entry/','ledger/')):print('LINK',a.get('href'),a.get_text(' ',strip=True)[:70])\nfor f in s.select('form'):\n print('FORM', f.get('action'), f.get('method'),[(a.get('name'),a.get('value')) for a in f.select('input')])\nfor x in s(['script','style','nav','footer']):x.decompose()\nprint('TEXT',s.get_text(' ',strip=True)[:2400])\nPY\ndone\n"]
