[110.432496, "i", "cat > /tmp/ledger-wire-test.py <<'PY'\nimport sys,socket,urllib.request,http.cookiejar,re\nbase='http://127.0.0.1:9090';p='/journal-entry/northstar-operations-dne37zdj/318c2ebe-20c7-4155-ade2-afddb72e26f8/update/80dd04ac-eedb-4b59-9a51-b3ec8ba733c6/';detail=p.replace('update/','detail/').replace('mark-as-posted/','')\n# entry URL ends at UUID, not at action\nentry='/journal-entry/northstar-operations-dne37zdj/318c2ebe-20c7-4155-ade2-afddb72e26f8/detail/80dd04ac-eedb-4b59-9a51-b3ec8ba733c6/'\ncj=http.cookiejar.MozillaCookieJar('/tmp/ledger.cookies');cj.load(ignore_discard=True,ignore_expires=True)\nop=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))\ndef view():\n h=op.open(base+entry,timeout=5).read().decode();print('ENTRY', 'UnPost' if 'mark-as-unposted/' in h else 'Post' if 'mark-as-posted/' in h else 'unknown', 'balanced lines' if 'Total' in h and '$17.00' in h else 'no balance')\nop.open(base+p+'mark-as-unposted/',timeout=5).read();view()\nsid=next(x.value for x in cj if x.name=='sessionid');post"]
[110.432672, "i", "=p+'mark-as-posted/'\nwire=('GET /work/ HTTP/1.1\\r\\nHost: 127.0.0.1:9090\\r\\nCookie: sessionid='+sid+'\\r\\nConnection: close\\r\\n\\r\\nGET '+post+' HTTP/1.1\\r\\nHost: 127.0.0.1:9090\\r\\nCookie: sessionid='+sid+'\\r\\nConnection: close\\r\\n\\r\\n').encode()\ns=socket.create_connection(('127.0.0.1',9090),timeout=4);s.settimeout(2);s.sendall(wire);b=b''\ntry:\n while len(b)<80000:\n  r=s.recv(8192)\n  if not r:break\n  b+=r\nexcept TimeoutError:pass\ns.close();print('WIRE RESPONSE STATUSES',re.findall(rb'HTTP/1\\.[01] [0-9]{3} [^\\r\\n]+',b)[:4]);print('RESPONSE BYTES',len(b));view()\nPY\npython3 /tmp/ledger-wire-test.py\n"]
