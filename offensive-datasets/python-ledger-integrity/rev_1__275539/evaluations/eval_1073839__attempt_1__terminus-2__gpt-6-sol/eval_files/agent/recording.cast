[144.119402, "o", "\u001b[?2004h\u001b[01;32mauditor@b73961f4900f\u001b[00m:\u001b[01;34m/testbed\u001b[00m$ "]
[144.772413, "i", "cat > /tmp/ledger-proof-replay.py <<'PY'\nimport urllib.request,urllib.parse,http.cookiejar,json,re,socket,sys,time\nsteps=json.load(open('/testbed/proof.json'))['steps'];base='http://127.0.0.1:9090';jar=http.cookiejar.CookieJar();opener=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar));vars={}\ndef sub(x):\n def repl(m):\n  typ,name=m.group(1,2)\n  return vars[name] if typ=='var' else next(c.value for c in jar if c.name==name)\n return re.sub(r'\\{\\{(var|cookie):([a-zA-Z0-9_-]+)\\}\\}',repl,x)\nfor i,step in enumerate(steps,1):\n if step['op']=='http':\n  p=sub(step['path']);f=urllib.parse.urlencode({k:sub(v) for k,v in step.get('form',{}).items()}).encode() if 'form' in step else None\n  req=urllib.request.Request(base+p,data=f,method=step['method']);r=opener.open(req,timeout=6);body=r.read().decode(errors='replace');print(i,step['method'],r.status,'body',len(body))\n  if i in (4,6,8):print('   official detail post-action:', 'UnPost' if 'mark-as-unposted/' in body else 'Post' if 'mark-as-posted/' in bod"]
[144.772445, "i", "y else 'none', 'balanced $17:', 'Total' in body and '$17.00' in body)\n else:\n  wire=''.join(sub(chunk['text']) for chunk in step['sends']).encode();s=socket.create_connection(('127.0.0.1',9090),timeout=5);s.settimeout(step['read_timeout_ms']/1000);s.sendall(wire);data=b''\n  try:\n   while len(data)<65536:\n    b=s.recv(8192)\n    if not b:break\n    data+=b\n  except (TimeoutError,ConnectionResetError):pass\n  s.close();body=data.decode(errors='replace');print(i,'raw',re.findall(r'HTTP/1\\.[01] \\d{3} [^\\r\\n]+',body)[:5])\n for c in step.get('captures',[]):\n  matches=list(re.finditer(c['pattern'],body));assert len(matches)==1,(i,c['name'],len(matches));vars[c['name']]=matches[0].group(1);print('   captured',c['name'],len(vars[c['name']]))\nprint('RESULT vars',list(vars))\nPY\ncurl -sS -i --max-time 8 -X POST http://127.0.0.1:19999/control/public-reset | head -12\n"]
