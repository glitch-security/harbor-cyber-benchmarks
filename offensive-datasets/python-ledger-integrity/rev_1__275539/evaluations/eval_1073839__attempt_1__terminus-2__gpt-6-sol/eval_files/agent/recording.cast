[47.249969, "i", "cat > /tmp/ledger-inspect.py <<'PY'\nfrom html.parser import HTMLParser\nimport sys\nclass P(HTMLParser):\n def __init__(self):super().__init__();self.links=[];self.forms=[];self.text=[];self.link=None;self.form=None;self.skip=0\n def handle_starttag(self,t,attrs):\n  a=dict(attrs)\n  if t in ('script','style'):self.skip+=1\n  if t=='a':self.link=[a.get('href',''),'']\n  if t=='form':self.form=[a.get('action'),a.get('method'),[]]\n  if t in ('input','button','select') and self.form is not None:self.form[2].append((t,a.get('name'),a.get('value'),a.get('type')))\n def handle_data(self,d):\n  if self.skip:return\n  d=d.strip()\n  if d:\n   self.text.append(d)\n   if self.link:self.link[1]+=' '+d\n def handle_endtag(self,t):\n  if t in ('script','style'):self.skip=max(0,self.skip-1)\n  if t=='a' and self.link:self.links.append(self.link);self.link=None\n  if t=='form' and self.form:self.forms.append(self.form);self.form=None\np=P();p.feed(open(sys.argv[1]).read())\nprint('TEXT', ' '.join(p.text)[:4200]);print('FORMS',p.forms)\nprint('R"]
