[76.088506, "i", "python3 - <<'PY'\nimport socket,http.cookiejar\npath='/journal-entry/northstar-operations-dne37zdj/318c2ebe-20c7-4155-ade2-afddb72e26f8/update/80dd04ac-eedb-4b59-9a51-b3ec8ba733c6/mark-as-posted/'\nc=dict((x.name,x.value) for x in http.cookiejar.MozillaCookieJar('/tmp/ledger.cookies')) if False else {}\nfor line in open('/tmp/ledger.cookies'):\n p=line.split('\\t')\n if len(p)==7:c[p[5]]=p[6].strip()\nwire=f'GET {path} HTTP/1.0\\r\\nHost: 127.0.0.1:9090\\r\\nCookie: sessionid={c[\"sessionid\"]}\\r\\n\\r\\n'.encode()\ns=socket.create_connection(('127.0.0.1',9090),timeout=4);s.settimeout(3);s.sendall(wire)\ntry:print(s.recv(3000).decode(errors='replace')[:1400])\nexcept TimeoutError:print('TIMEOUT')\ns.close()\nPY\n"]
