[43.382021, "i", "detail=$(grep -Eo '/journal-entry/[^\" ]+/detail/[^\" ]+/' /tmp/work.html | head -1); mark=$(grep -Eo '/journal-entry/[^\" ]+/update/[^\" ]+/mark-as-posted/' /tmp/work.html | head -1); ledger=$(grep -Eo '/ledger/[^\" ]+/list/current/' /tmp/work.html | head -1); printf 'detail=%s\\nmark=%s\\nledger=%s\\n' \"$detail\" \"$mark\" \"$ledger\"; curl -sS --max-time 5 -b /tmp/ledger.cookies \"http://127.0.0.1:9090$detail\" -o /tmp/detail.html; curl -sS --max-time 5 -b /tmp/ledger.cookies \"http://127.0.0.1:9090$ledger\" -o /tmp/ledgers.html; curl -sS --max-time 5 -b /tmp/ledger.cookies -D /tmp/markget.headers \"http://127.0.0.1:9090$mark\" -o /tmp/markget.html\n"]
[43.382755, "o", "detail=$(grep -Eo '/journal-entry/[^\" ]+/detail/[^\" ]+/' /tmp/work.html | head -1); mark=$(grep -Eo '/journal-entry/[^\" ]+/update/[^\" ]+/mark-as-posted/' /tmp/work.html | head -1); ledger=$(grep -Eo '/ledger/[^\" ]+/list/current/' /tmp/work.html | head -1); printf 'detail=%s\\nmark=%s\\nledger=%s\\n' \"$detail\" \"$mark\" \"$ledger\"; curl -sS --max-time 5 -b /tmp/ledger.cookies \"http://127.0.0.1:9090$detail\" -o /tmp/detail.html; curl -sS --max-time 5 -b /tmp/ledger.cookies \"http://127.0.0.1:9090$ledger\" -o /tmp/ledgers.html; curl -sS --max-time 5 -b /tmp/ledger.cookies -D /tmp/markget.headers \"http://127.0.0.1:9090$mark\" -o /tmp/markget.html\r\n\u001b[?2004l\r"]
