[243.150951, "i", "cat > /tmp/test_closedledger.py <<'PY'\nimport re,urllib.request\nbase='http://127.0.0.1:9090'; sid=open('/tmp/sessionid').read().strip()\nop=urllib.request.build_opener(); op.addheaders=[('Cookie','sessionid='+sid)]\nll=open('/tmp/ledger_list.html').read(); jl=open('/tmp/je_list.html').read()\nunpost=re.search(r'href=\"(/ledger/[^\\\"]+/action/[^\\\"]+/unpost/)\\?',ll).group(1)\nledgerbase=unpost[:-len('unpost/')]\nje_post=re.search(r'href=\"(/journal-entry/[^\\\"]+/mark-as-posted/)\\?',jl).group(1)\nje_detail=re.search(r'href=\"(/journal-entry/[^\\\"]+/detail/[^\\\"]+/)\"',jl).group(1)\nprint('unpost',unpost); print('je_post',je_post)\nr=op.open(base+unpost,timeout=5); print('ledger unpost final',r.status,r.url)\nstate=op.open(base+'/ledger/'+unpost.split('/')[2]+'/list/current/',timeout=5).read().decode()\nprint('ledger now offers post:', ledgerbase+'post/' in state, 'offers unpost:', ledgerbase+'unpost/' in state)\nr=op.open(base+je_post,timeout=5); print('JE post final',r.status,r.url)\nd=op.open(base+je_detail,timeout=5).read().deco"]
[243.150986, "i", "de()\naccepted='mark-as-unposted/' in d and 'mark-as-posted/' not in d\nprint('JE posted while ledger unposted:',accepted)\nif accepted:\n r=op.open(base+ledgerbase+'post/',timeout=5); print('ledger reopen final',r.status,r.url)\n state=op.open(base+'/ledger/'+unpost.split('/')[2]+'/list/current/',timeout=5).read().decode()\n d=op.open(base+je_detail,timeout=5).read().decode()\n print('final ledger posted:',ledgerbase+'unpost/' in state)\n print('final JE posted:','mark-as-unposted/' in d and 'mark-as-posted/' not in d)\n print('amount occurrences:',d.count('$17.00'))\nPY\npython3 /tmp/test_closedledger.py\n"]
