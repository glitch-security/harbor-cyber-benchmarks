[43.456267, "o", "\u001b[?2004h\u001b[01;32mauditor@9d0b64581c61\u001b[00m:\u001b[01;34m/testbed\u001b[00m$ "]
[44.708062, "i", "python3 - <<'PY'\nfrom bs4 import BeautifulSoup\nfor fn in ['/tmp/detail.html','/tmp/ledgers.html','/tmp/markget.html']:\n print('\\n###',fn)\n s=BeautifulSoup(open(fn),'html.parser')\n print('FORMS:',[(f.get('method'),f.get('action'),[(i.get('name'),i.get('value'),i.get('type')) for i in f.select('input,select,textarea,button')]) for f in s.select('form')])\n text=' | '.join(x.strip() for x in s.stripped_strings if x.strip())\n print(text[:5000])\nPY\nprintf '%s\\n' '--- mark GET headers ---'; sed -n '1,20p' /tmp/markget.headers\n"]
