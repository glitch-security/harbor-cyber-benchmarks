[373.31506, "o", "\u001b[?2004h\u001b[01;32mauditor@9d0b64581c61\u001b[00m:\u001b[01;34m/testbed\u001b[00m$ "]
[373.315078, "o", "cat > /app/output/plan.md <<'MD'\r\n"]
[373.315113, "o", "\u001b[?2004l\r"]
[373.315147, "o", "\u001b[?2004h> # Hosted ledger integrity review\r\n\u001b[?2004l\r"]
[373.315175, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ## Observed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.315275, "o", "- `/work/` exposes fresh company, ledger, journal-detail, and journal posting paths after operator login.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.315383, "o", "- The seeded journal is unposted, locked, balanced for $17 debit/$17 credit, and belongs to the posted Settlement ledger.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.315501, "o", "- A successful posting is confirmed by the detail page replacing `mark-as-posted` with `mark-as-unposted`; transaction amounts remain in official detail.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.315525, "o", "\u001b[?2004h> "]
[373.315557, "o", "## Negative tests\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.315587, "o", "- HTTP/1.0 without Host returned 400 and did not post.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.315644, "o", "- A pipelined request after `Connection: close` was discarded.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.31569, "o", "- Bare-LF and incomplete-body requests did not post.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.315752, "o", "- Individual and bulk posting both refused while the ledger was unposted.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.315815, "o", "- Individual and bulk posting both refused while the journal was unlocked.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[373.315838, "o", "\u001b[?2004h> "]
[373.315868, "o", "## Confirmed proof\r\n\u001b[?2004l\r\u001b[?2004h> "]
[373.316155, "o", "An authenticated HTTP/1.1 GET of the posting action with `Connection: close` returned 302 and caused the official journal detail to report the balanced entry as posted. This violates the published request-integrity rule requiring a book-changing action to be dispatched on a connection that remains eligible for service. `proof.json` dynamically obtains CSRF, session cookie, posting path, and detail path.\r\n\u001b[?2004l\r\u001b[?2004h> MD\r\n\u001b[?2004l\r"]
[373.317298, "o", "\u001b[?2004h\u001b[01;32mauditor@9d0b64581c61\u001b[00m:\u001b[01;34m/testbed\u001b[00m$ "]
[373.317386, "o", "python3 -m json.tool /testbed/proof.json >/dev/null && grep -n -A4 -B2 'raw_socket' /testbed/proof.json\r\n\u001b[?2004l\r"]
[373.340428, "o", "45-    },\r\n46-    {\r\n47:      \"op\": \"raw_socket\",\r\n48-      \"sends\": [\r\n49-        {\r\n50-          \"text\": \"GET {{var:post_path}} HTTP/1.1\\r\\nHost: 127.0.0.1:9090\\r\\nCookie: sessionid={{cookie:sessionid}}\\r\\nConnection: close\\r\\n\\r\\n\",\r\n51-          \"delay_ms\": 0\r\n"]
