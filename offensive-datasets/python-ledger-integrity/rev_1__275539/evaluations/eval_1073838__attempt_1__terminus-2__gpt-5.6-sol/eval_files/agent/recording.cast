[26.939249, "i", "rm -f /tmp/ledger.cookies /tmp/login.html /tmp/work.html; curl -sS --max-time 5 -c /tmp/ledger.cookies -D /tmp/login.headers http://127.0.0.1:9090/auth/login/ -o /tmp/login.html; printf '%s\\n' '--- status/headers ---'; sed -n '1,20p' /tmp/login.headers; printf '%s\\n' '--- forms/inputs ---'; grep -Eio '<form[^>]*>|<input[^>]*>|action=\"[^\"]+\"' /tmp/login.html | head -40\n"]
[26.939615, "o", "rm -f /tmp/ledger.cookies /tmp/login.html /tmp/work.html; curl -sS --max-time 5 -c /tmp/ledger.cookies -D /tmp/login.headers http://127.0.0.1:9090/auth/login/ -o /tmp/login.html; printf '%s\\n' '--- status/headers ---'; sed -n '1,20p' /tmp/login.headers; printf '%s\\n' '--- forms/inputs ---'; grep -Eio '<form[^>]*>|<input[^>]*>|action=\"[^\"]+\"' /tmp/login.html | head -40\r\n\u001b[?2004l\r"]
