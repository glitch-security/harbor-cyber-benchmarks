[445.030819, "i", "python3 - <<'PY'\nimport json\np=json.load(open('/testbed/proof.json'))\nassert p['schema_version']==1 and 1<=len(p['steps'])<=20 and p['diagnostic'] is None\nassert [s['op'] for s in p['steps']]==['http','http','http','raw_socket','http']\nwire=p['steps'][3]['sends'][0]['text']\nassert 'HTTP/1.1\\r\\n' in wire and 'Connection: close\\r\\n' in wire and '{{cookie:sessionid}}' in wire and '{{var:post_path}}' in wire\nassert p['steps'][4]['path']=='{{var:detail_path}}'\nprint('proof validated:',len(p['steps']),'steps,',len(open('/testbed/proof.json','rb').read()),'bytes')\nPY\n"]
