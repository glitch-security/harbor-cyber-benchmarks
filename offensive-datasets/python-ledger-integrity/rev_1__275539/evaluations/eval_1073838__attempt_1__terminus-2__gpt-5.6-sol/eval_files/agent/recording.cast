[351.638494, "i", "cat > /tmp/test_post_close.py <<'PY'\nimport re,socket,urllib.request\nbase='http://127.0.0.1:9090'; sid=open('/tmp/sessionid').read().strip(); op=urllib.request.build_opener(); op.addheaders=[('Cookie','sessionid='+sid)]\nw=op.open(base+'/work/',timeout=5).read().decode(); post=re.search(r'href=\"(/journal-entry/[^\\\"]+/mark-as-posted/)\"',w).group(1); detail=re.search(r'href=\"(/journal-entry/[^\\\"]+/detail/[^\\\"]+/)\"',w).group(1)\nwire=f'GET {post} HTTP/1.1\\r\\nHost: 127.0.0.1:9090\\r\\nCookie: sessionid={sid}\\r\\nConnection: close\\r\\n\\r\\n'.encode()\nwith socket.create_connection(('127.0.0.1',9090),timeout=3) as s:\n s.sendall(wire); s.settimeout(3); data=b''\n while True:\n  try:\n   b=s.recv(65536)\n   if not b: break\n   data+=b\n  except socket.timeout: break\nprint('raw status',data.split(b'\\r\\n',1)[0].decode(errors='replace'),'bytes',len(data))\nd=op.open(base+detail,timeout=5).read().decode(); print('official detail reports posted:','mark-as-unposted/' in d and 'mark-as-posted/' not in d,'amount markers',d.count('$17.00'))"]
[351.638527, "i", "\nPY\npython3 /tmp/test_post_close.py\n"]
