[99.757318, "i", "cat > /tmp/test_raw10.py <<'PY'\nimport http.cookiejar, re, socket, urllib.parse, urllib.request\nbase='http://127.0.0.1:9090'\ncj=http.cookiejar.CookieJar()\nop=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))\nlogin=op.open(base+'/auth/login/',timeout=5).read().decode()\ncsrf=re.findall(r'name=\"csrfmiddlewaretoken\" value=\"([^\"]+)\"',login)\nassert len(csrf)==1, csrf\nbody=urllib.parse.urlencode({'csrfmiddlewaretoken':csrf[0],'username':'operator','password':'LedgerLab987!'}).encode()\nreq=urllib.request.Request(base+'/auth/login/',body,headers={'Referer':base+'/auth/login/'})\nop.open(req,timeout=5).read()\nwork=op.open(base+'/work/',timeout=5).read().decode()\npost=re.findall(r'href=\"(/journal-entry/[^\"]+/mark-as-posted/)\"',work)\ndetail=re.findall(r'href=\"(/journal-entry/[^\"]+/detail/[^\"]+/)\"',work)\nassert len(post)==len(detail)==1,(post,detail)\nsid=next(c.value for c in cj if c.name=='sessionid')\nwire=f'GET {post[0]} HTTP/1.0\\r\\nCookie: sessionid={sid}\\r\\n\\r\\n'.encode()\nwith socket.create_connection"]
[99.757492, "o", "cat > /tmp/test_raw10.py <<'PY'\r\nimport http.cookiejar, re, socket, urllib.parse, urllib.request\r\nbase='http://127.0.0.1:9090'\r\ncj=http.cookiejar.CookieJar()\r\nop=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))\r\nlogin=op.open(base+'/auth/login/',timeout=5).read().decode()\r\ncsrf=re.findall(r'name=\"csrfmiddlewaretoken\" value=\"([^\"]+)\"',login)\r\nassert len(csrf)==1, csrf\r\nbody=urllib.parse.urlencode({'csrfmiddlewaretoken':csrf[0],'username':'operator','password':'LedgerLab987!'}).encode()\r\nreq=urllib.request.Request(base+'/auth/login/',body,headers={'Referer':base+'/auth/login/'})\r\nop.open(req,timeout=5).read()\r\nwork=op.open(base+'/work/',timeout=5).read().decode()\r\npost=re.findall(r'href=\"(/journal-entry/[^\"]+/mark-as-posted/)\"',work)\r\ndetail=re.findall(r'href=\"(/journal-entry/[^\"]+/detail/[^\"]+/)\"',work)\r\nassert len(post)==len(detail)==1,(post,detail)\r\nsid=next(c.value for c in cj if c.name=='sessionid')\r\nwire=f'GET {post[0]} HTTP/1.0\\r\\nCookie: sessionid={sid}\\r\\n\\r\\n'.encode()\r\nwith socket."]
[99.757525, "i", "(('127.0.0.1',9090),timeout=3) as s:\n s.sendall(wire); s.settimeout(2); chunks=[]\n while True:\n  try:\n   b=s.recv(65536)\n   if not b: break\n   chunks.append(b)\n  except socket.timeout: break\nresp=b''.join(chunks).decode(errors='replace')\nprint('RAW STATUS:',resp.split('\\r\\n',1)[0]); print('\\n'.join(resp.split('\\r\\n')[1:8]))\nafter=op.open(base+detail[0],timeout=5).read().decode()\nprint('post action remains:', 'mark-as-posted/' in after)\nprint('unpost action present:', 'mark-as-unposted/' in after)\nprint('balanced amounts:', after.count('$17.00'))\nassert 'mark-as-unposted/' in after and 'mark-as-posted/' not in after\nPY\npython3 /tmp/test_raw10.py\n"]
[99.757559, "o", "create_connection(('127.0.0.1',9090),timeout=3) as s:\r\n s.sendall(wire); s.settimeout(2); chunks=[]\r\n while True:\r\n  try:\r\n   b=s.recv(65536)\r\n   if not b: break\r\n   chunks.append(b)\r\n  except socket.timeout: break\r\nresp=b''.join(ch"]
[99.757591, "o", "unks).decode(errors='replace')\r\nprint('RAW STATUS:',resp.split('\\r\\n',1)[0]); print('\\n'.join(resp.split('\\r\\n')[1:8]))\r\nafter=op.open(base+detail[0],timeout=5).read().decode()\r\npr"]
