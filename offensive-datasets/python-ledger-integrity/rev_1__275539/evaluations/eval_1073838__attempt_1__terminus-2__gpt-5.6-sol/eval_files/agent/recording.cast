[61.062038, "i", "python3 - <<'PY'\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nclass P(HTMLParser):\n def __init__(self): super().__init__(); self.text=[]; self.forms=[]; self.form=None\n def handle_starttag(self,t,a):\n  d=dict(a)\n  if t=='form': self.form={'method':d.get('method'),'action':d.get('action'),'fields':[]}; self.forms.append(self.form)\n  if self.form is not None and t in ('input','button','select','textarea'): self.form['fields'].append((t,d.get('name'),d.get('value'),d.get('type')))\n def handle_endtag(self,t):\n  if t=='form': self.form=None\n def handle_data(self,d):\n  d=' '.join(d.split())\n  if d: self.text.append(d)\nfor fn in ('/tmp/detail.html','/tmp/ledgers.html','/tmp/markget.html'):\n p=P(); p.feed(Path(fn).read_text(errors='replace')); print('\\n###',fn,'\\nFORMS',p.forms); print(' | '.join(p.text)[:7000])\nPY\n"]
