[440.038576, "i", "cat > /tmp/confirm_clean.py <<'PY'\nimport http.cookiejar,re,socket,urllib.parse,urllib.request\nbase='http://127.0.0.1:9090'; cj=http.cookiejar.CookieJar(); op=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))\nlogin=op.open(base+'/auth/login/',timeout=5).read().decode(); csrf=re.findall(r'name=\"csrfmiddlewaretoken\" value=\"([^\"]+)\"',login); assert len(csrf)==1\nbody=urllib.parse.urlencode({'csrfmiddlewaretoken':csrf[0],'username':'operator','password':'LedgerLab987!'}).encode()\nop.open(urllib.request.Request(base+'/auth/login/',body,headers={'Referer':base+'/auth/login/'}),timeout=5).read()\nwork=op.open(base+'/work/',timeout=5).read().decode(); posts=re.findall(r'href=\"(/journal-entry/[^\"]+/mark-as-posted/)\"',work); details=re.findall(r'href=\"(/journal-entry/[^\"]+/detail/[^\"]+/)\"',work); assert len(posts)==len(details)==1,(posts,details)\nsid=next(c.value for c in cj if c.name=='sessionid')\nwire=f'GET {posts[0]} HTTP/1.1\\r\\nHost: 127.0.0.1:9090\\r\\nCookie: sessionid={sid}\\r\\nConnection: close\\r\\n"]
[440.038614, "i", "\\r\\n'.encode()\nwith socket.create_connection(('127.0.0.1',9090),timeout=3) as s:\n s.sendall(wire); s.settimeout(3); response=b''\n while True:\n  try:\n   chunk=s.recv(65536)\n   if not chunk: break\n   response+=chunk\n  except socket.timeout: break\nprint('raw status:',response.split(b'\\r\\n',1)[0].decode(errors='replace'))\ndetail=op.open(base+details[0],timeout=5).read().decode()\nposted='mark-as-unposted/' in detail and 'mark-as-posted/' not in detail\nprint('clean replay official posted:',posted,'balanced amount markers:',detail.count('$17.00'))\nassert response.startswith(b'HTTP/1.1 302') and posted and detail.count('$17.00')>=4\nPY\npython3 /tmp/confirm_clean.py\n"]
