[292.711898, "i", "cat > /tmp/test_incomplete.py <<'PY'\nimport re,socket,time,urllib.request\nbase='http://127.0.0.1:9090'; sid=open('/tmp/sessionid').read().strip(); op=urllib.request.build_opener(); op.addheaders=[('Cookie','sessionid='+sid)]\nwork=op.open(base+'/work/',timeout=5).read().decode()\npost=re.search(r'href=\"(/journal-entry/[^\\\"]+/mark-as-posted/)\"',work).group(1)\ndetail=re.search(r'href=\"(/journal-entry/[^\\\"]+/detail/[^\\\"]+/)\"',work).group(1)\nwire=(f'GET {post} HTTP/1.1\\r\\nHost: 127.0.0.1:9090\\r\\nCookie: sessionid={sid}\\r\\nContent-Length: 10\\r\\n\\r\\nx').encode()\nresp=b''\nwith socket.create_connection(('127.0.0.1',9090),timeout=3) as s:\n s.sendall(wire); s.settimeout(2)\n try: resp=s.recv(65536)\n except socket.timeout: pass\nprint('response before incomplete request closed:',resp[:100].decode(errors='replace'))\ntime.sleep(.3)\nd=op.open(base+detail,timeout=5).read().decode()\nprint('JE posted after incomplete request:','mark-as-unposted/' in d and 'mark-as-posted/' not in d,'amount markers',d.count('$17.00'))\nPY\npython3 /"]
