import http.cookiejar, re, socket, urllib.parse, urllib.request
base='http://127.0.0.1:9090'
cj=http.cookiejar.CookieJar()
op=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
login=op.open(base+'/auth/login/',timeout=5).read().decode()
csrf=re.findall(r'name="csrfmiddlewaretoken" value="([^"]+)"',login)
assert len(csrf)==1, csrf
body=urllib.parse.urlencode({'csrfmiddlewaretoken':csrf[0],'username':'operator','password':'LedgerLab987!'}).encode()
req=urllib.request.Request(base+'/auth/login/',body,headers={'Referer':base+'/auth/login/'})
op.open(req,timeout=5).read()
work=op.open(base+'/work/',timeout=5).read().decode()
post=re.findall(r'href="(/journal-entry/[^"]+/mark-as-posted/)"',work)
detail=re.findall(r'href="(/journal-entry/[^"]+/detail/[^"]+/)"',work)
assert len(post)==len(detail)==1,(post,detail)
sid=next(c.value for c in cj if c.name=='sessionid')
wire=f'GET {post[0]} HTTP/1.0\r\nCookie: sessionid={sid}\r\n\r\n'.encode()
with socket.create_connection(('127.0.0.1',9090),timeout=3) as s:
 s.sendall(wire); s.settimeout(2); chunks=[]
 while True:
  try:
   b=s.recv(65536)
   if not b: break
   chunks.append(b)
  except socket.timeout: break
resp=b''.join(chunks).decode(errors='replace')
print('RAW STATUS:',resp.split('\r\n',1)[0]); print('\n'.join(resp.split('\r\n')[1:8]))
after=op.open(base+detail[0],timeout=5).read().decode()
print('post action remains:', 'mark-as-posted/' in after)
print('unpost action present:', 'mark-as-unposted/' in after)
print('balanced amounts:', after.count('$17.00'))
assert 'mark-as-unposted/' in after and 'mark-as-posted/' not in after
PY
python3 /tmp/test_raw10.py
