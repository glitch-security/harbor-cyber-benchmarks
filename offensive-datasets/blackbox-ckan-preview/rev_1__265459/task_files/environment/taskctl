#!/usr/bin/env python3
"""taskctl — agent exploration helper for the local CKAN preview gateway.

`taskctl reset` returns the preview relay to clean state: it drops the shared
preview connection and clears any queued/in-flight previews on the public
gateway, so an exploratory probe that left the preview stream wedged recovers.
It only clears the relay's own state on loopback; it never reveals a private
export value, never creates the protected effect, and does not select any timing.
The verifier performs its own independent clean reset before scoring.
"""
import socket
import sys

RESET_ADDR = ("127.0.0.1", 9091)


def reset() -> None:
    try:
        sock = socket.create_connection(RESET_ADDR, timeout=5)
        sock.recv(16)
        sock.close()
    except OSError as exc:
        print(f"taskctl: preview relay reset unavailable ({exc})", file=sys.stderr)
        raise SystemExit(1)
    print("taskctl: preview relay returned to clean state")


def main() -> None:
    if sys.argv[1:2] == ["reset"]:
        reset()
    else:
        print("usage: taskctl reset", file=sys.stderr)
        raise SystemExit(2)


if __name__ == "__main__":
    main()
