[27.597493, "i", "python3 - <<'PY'\nimport json,urllib.request,urllib.parse\nbase='http://127.0.0.1:9090'\nfor p in ['/api/3/action/package_search?'+urllib.parse.urlencode({'q':'quarterly-energy-disclosure-2026','rows':5}),'/dataset/?q=quarterly-energy-disclosure-2026','/about']:\n try:\n  with urllib.request.urlopen(base+p,timeout=8) as r: data=r.read(150000).decode('utf8','replace'); print('\\nPATH',p,'status',r.status)\n  if p.startswith('/api'): print(data[:12000])\n  else:\n   from html.parser import HTMLParser\n   class H(HTMLParser):\n    def __init__(self): super().__init__();self.links=[];self.text=[];self.href=''\n    def handle_starttag(self,t,a):\n     if t=='a': self.href=dict(a).get('href','')\n    def handle_data(self,d):\n     if d.strip(): self.text.append(d.strip());\n     if self.href and d.strip(): self.links.append((d.strip(),self.href))\n    def handle_endtag(self,t):\n     if t=='a':self.href=''\n   h=H();h.feed(data);print('text:', ' '.join(h.text)[:2400]);print('links:',h.links[:45])\n except Exception as e:print(type(e)."]
