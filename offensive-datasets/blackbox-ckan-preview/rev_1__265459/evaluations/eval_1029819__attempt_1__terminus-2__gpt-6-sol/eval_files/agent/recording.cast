[307.498446, "i", "python3 - <<'PY'\nimport urllib.request,json,re\nb='http://127.0.0.1:9090'\nfor p in ['/organization/about/energy-authority','/organization/about/city-open-data']:\n try:\n  with urllib.request.urlopen(b+p,timeout=8) as r:s=r.read(65000).decode('utf8','replace');print('\\n',p,'status',r.status,'matches',[(m.group(0),re.sub(r'\\s+',' ',s[max(0,m.start()-100):m.end()+160])[:280]) for m in list(re.finditer(r'quarterly|catalog|revision|export|private|disclosure',s,re.I))[:8]])\n except urllib.error.HTTPError as e:print(p,'HTTP',e.code)\nj=json.load(urllib.request.urlopen(b+'/api/3/action/package_search?rows=100',timeout=8))['result']['results']\nfor d in j:\n s=json.dumps(d,ensure_ascii=False);hits=[m.group(0) for m in re.finditer('quarterly|disclosure|revision|catalog|export',s,re.I)];print(d['name'],'revision/export mentions',hits[:10],'resource formats',[(r['format'],r.get('datastore_active'),r.get('url_type')) for r in d['resources']])\nPY\n"]
