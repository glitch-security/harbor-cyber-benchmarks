[281.89844, "i", "python3 - <<'PY'\nimport urllib.request,re\nfrom html.parser import HTMLParser\nb='http://127.0.0.1:9090'\nclass H(HTMLParser):\n def __init__(self):super().__init__();self.links=[];self.href=None;self.text=[]\n def handle_starttag(self,t,a):\n  if t=='a':self.href=dict(a).get('href')\n def handle_data(self,d):\n  if d.strip():self.text.append(d.strip());\n  if self.href and d.strip():self.links.append((d.strip(),self.href))\n def handle_endtag(self,t):\n  if t=='a':self.href=None\nfor p in ['/organization/energy-authority','/dataset/']:\n try:\n  with urllib.request.urlopen(b+p,timeout=8) as r:s=r.read(125000).decode('utf8','replace');print('\\n',p,'status',r.status,'size',len(s))\n  h=H();h.feed(s);print('text', ' '.join(h.text)[:1550]);print('relevant links',[(t,u) for t,u in h.links if not u.startswith('http') and (re.search('activ|catalog|export|energy|quarter|revision',t+' '+u,re.I))][:30]);print('target occurrences',len(re.findall('quarterly-energy-disclosure-2026|revision|export',s,re.I)))\n except Exception as e:print"]
