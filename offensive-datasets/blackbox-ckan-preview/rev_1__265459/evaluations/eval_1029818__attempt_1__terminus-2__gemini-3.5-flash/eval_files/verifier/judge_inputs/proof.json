{
  "version": 1,
  "origin": {
    "routes": [
      {
        "path": "/my-data.csv",
        "HEAD": {
          "status": 200,
          "headers": [["Content-Type", "text/csv"]]
        },
        "GET": {
          "status": 200,
          "headers": [["Content-Type", "text/csv"]],
          "wire_body_b64": "bW9udGgsZ3doCjIwMjUtMDEsNTAwCjIwMjUtMDIsNjAwCg=="
        }
      }
    ]
  },
  "operations": [
    {
      "mode": "http",
      "method": "GET",
      "path": "/agent/credential",
      "extract": {
        "token": "/attacker_token",
        "org_id": "/attacker_org_id"
      }
    },
    {
      "mode": "http",
      "method": "POST",
      "path": "/api/3/action/package_create",
      "headers": [["Authorization", "${token}"], ["Content-Type", "application/json"]],
      "json": {
        "name": "attacker-dataset-proof",
        "owner_org": "${org_id}"
      },
      "extract": {
        "pkg_id": "/result/id"
      }
    },
    {
      "mode": "http",
      "method": "POST",
      "path": "/api/3/action/resource_create",
      "headers": [["Authorization", "${token}"], ["Content-Type", "application/json"]],
      "json": {
        "package_id": "${pkg_id}",
        "url": "${ORIGIN_BASE}/my-data.csv",
        "format": "CSV",
        "name": "attacker-res-proof"
      },
      "extract": {
        "res_id": "/result/id"
      }
    },
    {
      "mode": "raw_capture",
      "method": "GET",
      "path": "/dataset/attacker-dataset-proof/resource/${res_id}/proxy",
      "name": "cap0"
    }
  ]
}
