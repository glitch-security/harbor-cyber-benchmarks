[1238.447658, "i", "python3 -c '\nimport urllib.request, json\nroutes = [\n    \"power\", \"shutdown\", \"restart\", \"reboot\", \"control\", \"system\", \"update\",\n    \"upgrade\", \"upload\", \"download\", \"backup\", \"restore\", \"network\",\n    \"network_config\", \"preview\", \"relay\", \"preview_relay\", \"stream\",\n    \"preview_stream\", \"reset\", \"clear\", \"purge\", \"flush\", \"tasks\",\n    \"jobs\", \"queue\", \"config\", \"settings\", \"users\", \"auth\", \"login\",\n    \"logout\", \"register\", \"api\", \"catalog\", \"exports\", \"revisions\", \"logs\",\n    \"status\", \"info\", \"help\", \"metrics\", \"health\", \"version\"\n]\nfor r in routes:\n    try:\n        res = urllib.request.urlopen(f\"http://127.0.0.1:19999/{r}\").read().decode()\n        if \"unknown control route\" not in res:\n            print(f\"Found: /{r} -> {res}\")\n    except Exception as e:\n        if hasattr(e, \"read\"):\n            body = e.read().decode()\n            if \"unknown control route\" not in body:\n                print(f\"Found (Err): /{r} -> {body}\")\n        else:\n            print(f\"Err on /{r}: {e}\")\n'\n"]
