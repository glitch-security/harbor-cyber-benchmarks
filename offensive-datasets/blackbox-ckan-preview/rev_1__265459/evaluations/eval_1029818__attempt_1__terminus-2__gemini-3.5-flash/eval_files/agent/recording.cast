[137.128013, "o", "\u001b[?2004h\u001b[01;32mauditor@9a7b3b517fee\u001b[00m:\u001b[01;34m/testbed\u001b[00m$ "]
[143.390332, "i", "python3 -c '\nimport socket, struct\ndef decode_ip_port(s):\n    ip, port = s.split(\":\")\n    ip = socket.inet_ntoa(struct.pack(\"<L\", int(ip, 16)))\n    port = int(port, 16)\n    return f\"{ip}:{port}\"\n\nfor line in open(\"/proc/net/tcp\").readlines()[1:]:\n    parts = line.split()\n    local = decode_ip_port(parts[1])\n    remote = decode_ip_port(parts[2])\n    state = parts[3]\n    if state == \"0A\": # LISTEN\n        print(f\"LISTEN: {local}\")\n    elif state == \"01\": # ESTABLISHED\n        pass\n'\n"]
[143.390486, "o", "python3 -c '\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.390516, "o", "import socket, struct\r\n\u001b[?2004l\r"]
[143.390539, "o", "\u001b[?2004h> "]
[143.390565, "o", "def decode_ip_port(s):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.39059, "o", "    ip, port = s.split(\":\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.390633, "o", "    ip = socket.inet_ntoa(struct.pack(\"<L\", int(ip, 16)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.390665, "o", "    port = int(port, 16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[143.390687, "o", "> "]
[143.390715, "o", "    return f\"{ip}:{port}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[143.390738, "o", "> "]
[143.390764, "o", "for line in open(\"/proc/net/tcp\").readlines()[1:]:\r\n\u001b[?2004l\r"]
[143.39079, "o", "\u001b[?2004h>     parts = line.split()\r\n\u001b[?2004l\r"]
[143.390819, "o", "\u001b[?2004h> "]
[143.390869, "o", "    local = decode_ip_port(parts[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.390907, "o", "    remote = decode_ip_port(parts[2])\r\n\u001b[?2004l\r\u001b[?2004h>     state = parts[3]\r\n\u001b[?2004l\r"]
[143.390938, "o", "\u001b[?2004h> "]
[143.390971, "o", "    if state == \"0A\": # LISTEN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.390997, "o", "        print(f\"LISTEN: {local}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.391027, "o", "    elif state == \"01\": # ESTABLISHED\r\n\u001b[?2004l\r\u001b[?2004h"]
[143.391056, "o", ">         pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[143.391077, "o", "'\r\n\u001b[?2004l\r"]
