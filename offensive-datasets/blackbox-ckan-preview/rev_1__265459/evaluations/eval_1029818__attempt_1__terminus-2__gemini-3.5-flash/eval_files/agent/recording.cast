[586.656111, "o", "    s = socket.create_connection((\"127.0.0.1\", 5210), timeout=3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.65615, "o", "    print(\"Connected!\")\r\n\u001b[?2004l\r"]
[586.656175, "o", "\u001b[?2004h> "]
[586.656202, "o", "    s.settimeout(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.656239, "o", "    data = s.recv(1024)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.656275, "o", "> "]
[586.656312, "o", "    print(\"Received:\", data)\r\n\u001b[?2004l\r\u001b[?2004h> except Exception as e:\r\n\u001b[?2004l\r"]
[586.656348, "o", "\u001b[?2004h> "]
[586.656385, "o", "    print(\"Error:\", e)\r\n\u001b[?2004l\r\u001b[?2004h> '\r\n\u001b[?2004l\r"]
[586.669977, "o", "Connected!\r\n"]
[588.671959, "o", "Error: timed out\r\n"]
