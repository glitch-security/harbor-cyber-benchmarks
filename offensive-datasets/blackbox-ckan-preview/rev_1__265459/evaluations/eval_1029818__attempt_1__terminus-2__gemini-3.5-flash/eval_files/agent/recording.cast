[849.566347, "i", "python3 -c '\nimport urllib.request, urllib.parse, re\nurl = \"http://127.0.0.1:9090/dataset/bus-fleet-roster/resource/2adf3de2-1888-4639-a677-16b7a0ea7fff/view/57af3cba-3507-4670-aaf1-5eb51d40ea98\"\nreq = urllib.request.urlopen(url)\ncookie = req.headers.get(\"Set-Cookie\").split(\";\")[0]\nhtml = req.read().decode()\ncsrf = re.search(r\"_csrf_token.*value=\\\"([^\\\"]+)\\\"\", html).group(1)\n\npost_data = urllib.parse.urlencode({\"_csrf_token\": csrf, \"filters\": \"\"}).encode()\nreq2 = urllib.request.Request(\n    \"http://127.0.0.1:9090/datatables/filtered-download/57af3cba-3507-4670-aaf1-5eb51d40ea98\",\n    data=post_data,\n    headers={\n        \"Cookie\": cookie,\n        \"Content-Type\": \"application/x-www-form-urlencoded\"\n    }\n)\ntry:\n    res = urllib.request.urlopen(req2)\n    print(\"Status:\", res.status)\n    print(\"Headers:\", res.headers)\n    body = res.read()\n    print(\"Body snippet:\", body[:200])\nexcept Exception as e:\n    print(\"Error:\", e)\n'\n"]
