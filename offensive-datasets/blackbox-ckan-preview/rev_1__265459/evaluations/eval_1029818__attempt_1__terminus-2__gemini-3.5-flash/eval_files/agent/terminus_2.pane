[?2004l[?2004h> import socket, struct
[?2004l[?2004h> def decode_ip_port(s):
[?2004l[?2004h>     ip, port = s.split(":")
[?2004l[?2004h>     ip = socket.inet_ntoa(struct.pack("<L", int(ip, 16)))
[?2004l[?2004h>     port = int(port, 16)
[?2004l[?2004h>     return f"{ip}:{port}"
[?2004l[?2004h> 
[?2004l[?2004h> for line in open("/proc/net/tcp").readlines()[1:]:
[?2004l[?2004h>     parts = line.split()
[?2004l[?2004h>     local = decode_ip_port(parts[1])
[?2004l[?2004h>     remote = decode_ip_port(parts[2])
[?2004l[?2004h>     state = parts[3]
[?2004l[?2004h>     if state == "0A": # LISTEN
[?2004l[?2004h>         print(f"LISTEN: {local}")
[?2004l[?2004h>     elif state == "01": # ESTABLISHED
[?2004l[?2004h>         pass
[?2004l[?2004h> '
